+static inline unsigned esp32s3_qr(const uint32_t insn) {
+    return (((insn >> 20) & 3u) << 1) | ((insn >> 15) & 1u);
+}
+
+static inline int32_t esp32s3_imm8x16(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 16;
+}
+
+static inline int32_t esp32s3_imm8x8(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 8;
+}
+
+static inline int32_t esp32s3_imm8x4(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 4;
+}
+
+static inline int64_t esp32s3_asr64(int64_t value, unsigned shift) {
+    if (!shift) return value;
+    uint64_t shifted = (uint64_t)value >> shift;
+    if (value < 0) shifted |= UINT64_MAX << (64 - shift);
+    return (int64_t)shifted;
+}
+
+static inline uint64_t esp32s3_accx_u40(const xtensa_cpu_t *cpu) {
+    return ((uint64_t)(cpu->accx[1] & 0xffu) << 32) | cpu->accx[0];
+}
+
+static inline int64_t esp32s3_accx_s40(const xtensa_cpu_t *cpu) {
+    uint64_t value = esp32s3_accx_u40(cpu);
+    if (value & (UINT64_C(1) << 39)) value |= UINT64_MAX << 40;
+    return (int64_t)value;
+}
+
+static inline void esp32s3_set_accx(xtensa_cpu_t *cpu, uint64_t value) {
+    cpu->accx[0] = (uint32_t)value;
+    cpu->accx[1] = (uint32_t)(value >> 32) & 0xffu;
+}
+
+static inline void esp32s3_qr_shift_pair(uint8_t output[16],
+                                         const uint8_t low[16],
+                                         const uint8_t high[16],
+                                         unsigned shift_bytes) {
+    for (unsigned i = 0; i < 16; i++) {
+        unsigned source = i + shift_bytes;
+        output[i] = source < 16 ? low[source] : high[source - 16];
+    }
+}
+
+static inline void esp32s3_copy_from_memory(xtensa_cpu_t *cpu, uint8_t *output,
+                                            uint32_t address, unsigned length) {
+    for (unsigned i = 0; i < length; i++) output[i] = mem_read8(cpu->mem, address + i);
+}
+
+static inline void esp32s3_copy_to_memory(xtensa_cpu_t *cpu, uint32_t address,
+                                          const uint8_t *input, unsigned length) {
+    for (unsigned i = 0; i < length; i++) mem_write8(cpu->mem, address + i, input[i]);
+}
+
+static inline uint16_t esp32s3_qr_get_u16(const uint8_t input[16], unsigned lane) {
+    uint16_t value;
+    memcpy(&value, input + lane * 2u, sizeof(value));
+    return value;
+}
+
+static inline int16_t esp32s3_qr_get_s16(const uint8_t input[16], unsigned lane) {
+    return (int16_t)esp32s3_qr_get_u16(input, lane);
+}
+
+static inline void esp32s3_qr_set_u16(uint8_t output[16], unsigned lane, uint16_t value) {
+    memcpy(output + lane * 2u, &value, sizeof(value));
+}
+
+static inline void esp32s3_pack_qacc_s16(xtensa_cpu_t *cpu, uint32_t output[5],
+                                         uint32_t address) {
+    for (unsigned i = 0; i < 5; i++) output[i] = 0;
+    for (unsigned lane = 0; lane < 4; lane++) {
+        uint64_t value = (uint64_t)(int64_t)sign_extend(
+            mem_read16(cpu->mem, address + lane * 2), 16) & 0xffffffffffull;
+        unsigned bit = lane * 40;
+        unsigned word = bit / 32;
+        unsigned shift = bit % 32;
+        output[word] |= (uint32_t)(value << shift);
+        output[word + 1] |= (uint32_t)(value >> (32 - shift));
+    }
+}
+
+static inline void esp32s3_pack_qacc_unsigned(xtensa_cpu_t *cpu,
+                                               uint32_t output[5],
+                                               uint32_t address,
+                                               unsigned element_bytes) {
+    unsigned lane_bits = element_bytes == 1 ? 20 : 40;
+    unsigned lane_count = 8 / element_bytes;
+    for (unsigned i = 0; i < 5; i++) output[i] = 0;
+    for (unsigned lane = 0; lane < lane_count; lane++) {
+        uint64_t value = element_bytes == 1
+            ? mem_read8(cpu->mem, address + lane)
+            : mem_read16(cpu->mem, address + lane * 2);
+        unsigned bit = lane * lane_bits;
+        unsigned word = bit / 32;
+        unsigned shift = bit % 32;
+        output[word] |= (uint32_t)(value << shift);
+        if (shift + element_bytes * 8 > 32)
+            output[word + 1] |= (uint32_t)(value >> (32 - shift));
+    }
+}
+
+static inline void esp32s3_zip8(xtensa_cpu_t *cpu, unsigned q0, unsigned q1) {
+    uint8_t first[16], second[16];
+    memcpy(first, cpu->qr[q0], sizeof(first));
+    memcpy(second, cpu->qr[q1], sizeof(second));
+    for (unsigned i = 0; i < 8; i++) {
+        cpu->qr[q0][i * 2] = first[i];
+        cpu->qr[q0][i * 2 + 1] = second[i];
+        cpu->qr[q1][i * 2] = first[i + 8];
+        cpu->qr[q1][i * 2 + 1] = second[i + 8];
+    }
+}
+
+static inline void esp32s3_unzip8(xtensa_cpu_t *cpu, unsigned q0, unsigned q1) {
+    uint8_t first[16], second[16];
+    memcpy(first, cpu->qr[q0], sizeof(first));
+    memcpy(second, cpu->qr[q1], sizeof(second));
+    for (unsigned i = 0; i < 8; i++) {
+        cpu->qr[q0][i] = first[i * 2];
+        cpu->qr[q0][i + 8] = second[i * 2];
+        cpu->qr[q1][i] = first[i * 2 + 1];
+        cpu->qr[q1][i + 8] = second[i * 2 + 1];
+    }
+}
