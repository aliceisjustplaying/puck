+static inline unsigned esp32s3_qr(const uint32_t insn) {
+    return (((insn >> 20) & 3u) << 1) | ((insn >> 15) & 1u);
+}
+
+static inline int32_t esp32s3_imm8x16(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 16;
+}
+
+static inline int32_t esp32s3_imm8x8(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 8;
+}
+
+static inline int32_t esp32s3_imm8x4(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 4;
+}
+
+static inline void esp32s3_copy_from_memory(xtensa_cpu_t *cpu, uint8_t *output,
+                                            uint32_t address, unsigned length) {
+    for (unsigned i = 0; i < length; i++) output[i] = mem_read8(cpu->mem, address + i);
+}
+
+static inline void esp32s3_copy_to_memory(xtensa_cpu_t *cpu, uint32_t address,
+                                          const uint8_t *input, unsigned length) {
+    for (unsigned i = 0; i < length; i++) mem_write8(cpu->mem, address + i, input[i]);
+}
+
+static inline void esp32s3_pack_qacc_s16(xtensa_cpu_t *cpu, uint32_t output[5],
+                                         uint32_t address) {
+    for (unsigned i = 0; i < 5; i++) output[i] = 0;
+    for (unsigned lane = 0; lane < 4; lane++) {
+        uint64_t value = (uint64_t)(int64_t)sign_extend(
+            mem_read16(cpu->mem, address + lane * 2), 16) & 0xffffffffffull;
+        unsigned bit = lane * 40;
+        unsigned word = bit / 32;
+        unsigned shift = bit % 32;
+        output[word] |= (uint32_t)(value << shift);
+        output[word + 1] |= (uint32_t)(value >> (32 - shift));
+    }
+}
+
+static inline void esp32s3_zip8(xtensa_cpu_t *cpu, unsigned q0, unsigned q1) {
+    uint8_t first[16], second[16];
+    memcpy(first, cpu->qr[q0], sizeof(first));
+    memcpy(second, cpu->qr[q1], sizeof(second));
+    for (unsigned i = 0; i < 8; i++) {
+        cpu->qr[q0][i * 2] = first[i];
+        cpu->qr[q0][i * 2 + 1] = second[i];
+        cpu->qr[q1][i * 2] = first[i + 8];
+        cpu->qr[q1][i * 2 + 1] = second[i + 8];
+    }
+}
+
+static inline void esp32s3_unzip8(xtensa_cpu_t *cpu, unsigned q0, unsigned q1) {
+    uint8_t first[16], second[16];
+    memcpy(first, cpu->qr[q0], sizeof(first));
+    memcpy(second, cpu->qr[q1], sizeof(second));
+    for (unsigned i = 0; i < 8; i++) {
+        cpu->qr[q0][i] = first[i * 2];
+        cpu->qr[q0][i + 8] = second[i * 2];
+        cpu->qr[q1][i] = first[i * 2 + 1];
+        cpu->qr[q1][i + 8] = second[i * 2 + 1];
+    }
+}
+
+/* Bounded ESP32-S3 LX7 subset used by the WebAssembly experiment. */
+static inline __attribute__((always_inline))
+int exec_esp32s3(xtensa_cpu_t *cpu, uint32_t insn) {
+    if ((insn & 0x8f000fu) == 0x830004u ||
+        (insn & 0x8f000fu) == 0x8a0004u) {
+        unsigned q = esp32s3_qr(insn);
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t address = base & ~15u;
+        if ((insn & 0x8f000fu) == 0x830004u)
+            esp32s3_copy_from_memory(cpu, cpu->qr[q], address, 16);
+        else
+            esp32s3_copy_to_memory(cpu, address, cpu->qr[q], 16);
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x16(insn));
+        return 1;
+    }
+
+    if ((insn & 0xcf700fu) == 0x8d2004u) {
+        unsigned q = esp32s3_qr(insn);
+        unsigned base_register = XT_T(insn);
+        unsigned increment_register = (insn >> 8) & 15u;
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t increment = ar_read(cpu, increment_register);
+        esp32s3_copy_from_memory(cpu, cpu->qr[q], base & ~15u, 16);
+        ar_write(cpu, base_register, base + increment);
+        return 1;
+    }
+
+    uint32_t float64_opcode = insn & 0x0f000fu;
+    if (float64_opcode == 0x060000u || float64_opcode == 0x070000u) {
+        unsigned low_float_register = (insn >> 20) & 15u;
+        unsigned high_float_register = (insn >> 12) & 15u;
+        unsigned increment_register = (insn >> 8) & 15u;
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t increment = ar_read(cpu, increment_register);
+        uint32_t address = base & ~7u;
+        if (float64_opcode == 0x060000u) {
+            cpu->fr[low_float_register] = bits_to_float(mem_read32(cpu->mem, address));
+            cpu->fr[high_float_register] = bits_to_float(mem_read32(cpu->mem, address + 4));
+        } else {
+            mem_write32(cpu->mem, address, float_to_bits(cpu->fr[low_float_register]));
+            mem_write32(cpu->mem, address + 4, float_to_bits(cpu->fr[high_float_register]));
+        }
+        ar_write(cpu, base_register, base + increment);
+        return 1;
+    }
+
+    uint32_t aligned_load_opcode = insn & 0x8f000fu;
+    if (aligned_load_opcode == 0x810004u || aligned_load_opcode == 0x820004u) {
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        unsigned q = esp32s3_qr(insn);
+        if (aligned_load_opcode == 0x810004u) {
+            esp32s3_copy_from_memory(cpu, cpu->qr[q], base & ~15u, 16);
+            cpu->sar_byte = base & 0xfu;
+            ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x16(insn));
+        } else {
+            uint32_t value = mem_read32(cpu->mem, base & ~3u);
+            for (unsigned i = 0; i < 4; i++) memcpy(cpu->qr[q] + i * 4, &value, 4);
+            ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x4(insn));
+        }
+        return 1;
+    }
+
+    if ((insn & 0xbf800fu) == 0x010004u) {
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t address = base & ~15u;
+        esp32s3_pack_qacc_s16(cpu, cpu->qacc_l, address);
+        esp32s3_pack_qacc_s16(cpu, cpu->qacc_h, address + 8);
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x16(insn));
+        return 1;
+    }
+
+    uint32_t accx_memory_opcode = insn & 0xbf800fu;
+    if (accx_memory_opcode == 0x0e0004u || accx_memory_opcode == 0x020004u) {
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t address = base & ~7u;
+        if (accx_memory_opcode == 0x0e0004u) {
+            cpu->accx[0] = mem_read32(cpu->mem, address);
+            cpu->accx[1] = mem_read32(cpu->mem, address + 4) & 0xffu;
+        } else {
+            mem_write32(cpu->mem, address, cpu->accx[0]);
+            mem_write32(cpu->mem, address + 4, cpu->accx[1]);
+        }
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x8(insn));
+        return 1;
+    }
+
+    uint32_t qacc_memory_opcode = insn & 0xbf800fu;
+    if (qacc_memory_opcode == 0x000004u || qacc_memory_opcode == 0x060004u ||
+        qacc_memory_opcode == 0x0c0004u || qacc_memory_opcode == 0x0d0004u) {
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t address = base & ~15u;
+        bool high_bank = qacc_memory_opcode == 0x060004u || qacc_memory_opcode == 0x0d0004u;
+        bool store = qacc_memory_opcode == 0x0c0004u || qacc_memory_opcode == 0x0d0004u;
+        uint32_t *qacc = high_bank ? cpu->qacc_h : cpu->qacc_l;
+        if (store)
+            for (unsigned i = 0; i < 4; i++) mem_write32(cpu->mem, address + i * 4, qacc[i]);
+        else
+            for (unsigned i = 0; i < 4; i++) qacc[i] = mem_read32(cpu->mem, address + i * 4);
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x16(insn));
+        return 1;
+    }
+    if (qacc_memory_opcode == 0x120004u || qacc_memory_opcode == 0x160004u ||
+        qacc_memory_opcode == 0x1d0004u || qacc_memory_opcode == 0x1e0004u) {
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        bool high_bank = qacc_memory_opcode == 0x120004u || qacc_memory_opcode == 0x1e0004u;
+        bool store = qacc_memory_opcode == 0x120004u || qacc_memory_opcode == 0x1d0004u;
+        uint32_t *qacc = high_bank ? cpu->qacc_h : cpu->qacc_l;
+        if (store)
+            mem_write32(cpu->mem, base & ~3u, qacc[4]);
+        else
+            qacc[4] = mem_read32(cpu->mem, base & ~3u);
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x4(insn));
+        return 1;
+    }
+
+    uint32_t half_opcode = insn & 0x8f000fu;
+    if (half_opcode == 0x890004u || half_opcode == 0x880004u ||
+        half_opcode == 0x8b0004u) {
+        unsigned q = esp32s3_qr(insn);
+        unsigned base_register = XT_T(insn);
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t address = base & ~7u;
+        if (half_opcode == 0x890004u)
+            esp32s3_copy_from_memory(cpu, cpu->qr[q], address, 8);
+        else if (half_opcode == 0x880004u)
+            esp32s3_copy_from_memory(cpu, cpu->qr[q] + 8, address, 8);
+        else
+            esp32s3_copy_to_memory(cpu, address, cpu->qr[q] + 8, 8);
+        ar_write(cpu, base_register, base + (uint32_t)esp32s3_imm8x8(insn));
+        return 1;
+    }
+
+    if ((insn & 0xcf7f0fu) == 0xcd2004u ||
+        (insn & 0xcf7f0fu) == 0xcd6004u) {
+        unsigned q = esp32s3_qr(insn);
+        uint32_t base = ar_read(cpu, XT_T(insn)) & ~15u;
+        int32_t offset = sign_extend((insn >> 8) & 15u, 4) * 16;
+        uint32_t address = base + (uint32_t)offset;
+        if ((insn & 0xcf7f0fu) == 0xcd2004u)
+            esp32s3_copy_from_memory(cpu, cpu->qr[q], address, 16);
+        else
+            esp32s3_copy_to_memory(cpu, address, cpu->qr[q], 16);
+        return 1;
+    }
+
+    uint32_t zip_opcode = insn & 0xcf0fffu;
+    if (zip_opcode == 0xcc03d4u || zip_opcode == 0xcc03a4u) {
+        unsigned q0 = (insn >> 12) & 7u;
+        unsigned q1 = esp32s3_qr(insn);
+        if (zip_opcode == 0xcc03d4u)
+            esp32s3_zip8(cpu, q0, q1);
+        else
+            esp32s3_unzip8(cpu, q0, q1);
+        return 1;
+    }
+    return 0;
+}
