+static inline __attribute__((always_inline))
+int exec_esp32s3(xtensa_cpu_t *cpu, uint32_t insn) {
+    if ((insn & 0x8f000fu) == 0x830004u ||
+        (insn & 0x8f000fu) == 0x8a0004u) {
