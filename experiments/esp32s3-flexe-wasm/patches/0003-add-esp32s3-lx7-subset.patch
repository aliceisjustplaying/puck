+static inline unsigned esp32s3_qr(const uint32_t insn) {
+    return (((insn >> 20) & 3u) << 1) | ((insn >> 15) & 1u);
+}
+
+static inline int32_t esp32s3_imm8x16(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 16;
+}
+
+static inline int32_t esp32s3_imm8x8(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 8;
+}
+
+static inline int32_t esp32s3_imm8x4(const uint32_t insn) {
+    uint32_t encoded = ((insn >> 8) & 0x7fu) | (((insn >> 22) & 1u) << 7);
+    return sign_extend(encoded, 8) * 4;
+}
+
+static inline int64_t esp32s3_asr64(int64_t value, unsigned shift) {
+    if (!shift) return value;
+    uint64_t shifted = (uint64_t)value >> shift;
+    if (value < 0) shifted |= UINT64_MAX << (64 - shift);
+    return (int64_t)shifted;
+}
+
+static inline uint64_t esp32s3_accx_u40(const xtensa_cpu_t *cpu) {
+    return ((uint64_t)(cpu->accx[1] & 0xffu) << 32) | cpu->accx[0];
+}
+
+static inline int64_t esp32s3_accx_s40(const xtensa_cpu_t *cpu) {
+    uint64_t value = esp32s3_accx_u40(cpu);
+    if (value & (UINT64_C(1) << 39)) value |= UINT64_MAX << 40;
+    return (int64_t)value;
+}
+
+static inline void esp32s3_set_accx(xtensa_cpu_t *cpu, uint64_t value) {
+    cpu->accx[0] = (uint32_t)value;
+    cpu->accx[1] = (uint32_t)(value >> 32) & 0xffu;
+}
+
+static inline uint64_t esp32s3_qacc_lane(const uint32_t bank[5],
+                                          unsigned lane, unsigned lane_bits) {
+    unsigned bit = lane * lane_bits;
+    unsigned word = bit / 32;
+    unsigned shift = bit % 32;
+    uint64_t window = bank[word];
+    if (word + 1 < 5) window |= (uint64_t)bank[word + 1] << 32;
+    return (window >> shift) & ((UINT64_C(1) << lane_bits) - 1);
+}
+
+static inline void esp32s3_set_qacc_lane(uint32_t bank[5], unsigned lane,
+                                         unsigned lane_bits, uint64_t value) {
+    unsigned bit = lane * lane_bits;
+    unsigned word = bit / 32;
+    unsigned shift = bit % 32;
+    uint64_t lane_mask = (UINT64_C(1) << lane_bits) - 1;
+    uint64_t window = bank[word];
+    if (word + 1 < 5) window |= (uint64_t)bank[word + 1] << 32;
+    window = (window & ~(lane_mask << shift)) | ((value & lane_mask) << shift);
+    bank[word] = (uint32_t)window;
+    if (word + 1 < 5) bank[word + 1] = (uint32_t)(window >> 32);
+}
+
+static inline int64_t esp32s3_sign_extend64(uint64_t value, unsigned bits) {
+    uint64_t sign = UINT64_C(1) << (bits - 1);
+    return (int64_t)((value ^ sign) - sign);
+}
+
+static inline void esp32s3_qacc_mac(xtensa_cpu_t *cpu,
+                                    const uint8_t source_x[16],
+                                    const uint8_t source_y[16],
+                                    unsigned element_bits, bool signed_data) {
+    unsigned lanes = 128 / element_bits;
+    unsigned bank_lanes = lanes / 2;
+    unsigned lane_bits = element_bits == 16 ? 40 : 20;
+    uint64_t lane_mask = (UINT64_C(1) << lane_bits) - 1;
+    for (unsigned lane = 0; lane < lanes; lane++) {
+        uint32_t *bank = lane < bank_lanes ? cpu->qacc_l : cpu->qacc_h;
+        unsigned bank_lane = lane % bank_lanes;
+        uint64_t current = esp32s3_qacc_lane(bank, bank_lane, lane_bits);
+        if (signed_data) {
+            int64_t x, y;
+            if (element_bits == 16) {
+                int16_t x16, y16;
+                memcpy(&x16, source_x + lane * 2, 2);
+                memcpy(&y16, source_y + lane * 2, 2);
+                x = x16;
+                y = y16;
+            } else {
+                x = (int8_t)source_x[lane];
+                y = (int8_t)source_y[lane];
+            }
+            int64_t value = esp32s3_sign_extend64(current, lane_bits) + x * y;
+            int64_t minimum = -(INT64_C(1) << (lane_bits - 1));
+            int64_t maximum = (INT64_C(1) << (lane_bits - 1)) - 1;
+            if (value < minimum) value = minimum;
+            if (value > maximum) value = maximum;
+            esp32s3_set_qacc_lane(bank, bank_lane, lane_bits, (uint64_t)value);
+        } else {
+            uint64_t x, y;
+            if (element_bits == 16) {
+                uint16_t x16, y16;
+                memcpy(&x16, source_x + lane * 2, 2);
+                memcpy(&y16, source_y + lane * 2, 2);
+                x = x16;
+                y = y16;
+            } else {
+                x = source_x[lane];
+                y = source_y[lane];
+            }
+            uint64_t value = current + x * y;
+            if (value > lane_mask) value = lane_mask;
+            esp32s3_set_qacc_lane(bank, bank_lane, lane_bits, value);
+        }
+    }
+}
