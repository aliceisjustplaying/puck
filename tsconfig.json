{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*.ts", "server.ts", "build.ts", "baselineStore.ts",
    "scripts/**/*.ts", "harness/**/*.ts", "example/*.ts", "test/**/*.ts",
    "packs/rp2350-touch-amoled-18/tools/*.ts", "packs/rp2350-touch-amoled-18/wasm/**/*.ts",
    "packs/web/**/*.ts",
    "site/**/*.ts"
  ],
  "//": "packs/rp2350-touch-amoled-18/tools/invariants/ is a separate project with its own tsconfig.json (it runs under a different toolchain contract); typecheck it there."
}
