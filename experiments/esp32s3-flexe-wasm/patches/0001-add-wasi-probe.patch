+                                       uint32_t reset_reason_core1,
+                                       uint32_t enable_memset,
+                                       uint32_t enable_cache_bootstrap) {
+    if (!mem || enable_memset > 1u || enable_cache_bootstrap > 1u) return 0;
+    elf_rom_reset_reasons[0] = reset_reason_core0;
+    elf_rom_reset_reasons[1] = reset_reason_core1;
+    elf_rom_reset_reason_enabled = 1;
+    elf_rom_memset_enabled = (int)enable_memset;
+    elf_rom_cache_enabled = (int)enable_cache_bootstrap;
+    return 1;
+}
