index 0000000..218fd96
--- /dev/null
+++ b/src/wasm_probe.c
@@ -0,0 +1,1226 @@
+/*
+ * Throwaway probe entry point for Puck's flexe WebAssembly experiment.
+ * This file is applied to a temporary copy of the pinned upstream sources.
+ */
+#include "xtensa.h"
+#include "memory.h"
+#include <stdint.h>
+#include <string.h>
+
+#ifdef FLEXE_PROBE_NATIVE
+#include <stdio.h>
+#define FLEXE_EXPORT(name)
+#else
+#define FLEXE_EXPORT(name) __attribute__((export_name(name)))
+#endif
+
+#define FIXTURE_PC 0x40070000u
+#define INPUT_CAPACITY 4096u
+#define DATA_CAPACITY 4096u
+#define PAGE_BYTES 4096u
+#define ELF_PAGE_CAPACITY 768u
+#define ELF_TRACE_CAPACITY 256u
+#define ELF_MEMORY_TRACE_CAPACITY 1024u
+#define ELF_UNSUPPORTED_CAPACITY 2048u
+#define ELF_ROM_EVENT_CAPACITY 64u
+#define ELF_ROM_EVENT_WORDS 5u
+#define ELF_ROM_MEMSET_MAX_BYTES 65536u
+#define ESP32S3_ROM_RESET_REASON 0x4000057cu
+#define ESP32S3_ROM_MEMSET 0x400011e8u
+#define ESP32S3_ROM_CACHE_DISABLE_I 0x4000186cu
+#define ESP32S3_ROM_CACHE_ENABLE_I 0x40001878u
+#define ESP32S3_ROM_CACHE_DISABLE_D 0x40001884u
+#define ESP32S3_ROM_CACHE_ENABLE_D 0x40001890u
+#define ESP32S3_ROM_SUSPEND_DCACHE 0x400018b4u
+#define ESP32S3_ROM_CONFIG_ICACHE_MODE 0x40001a1cu
+#define ESP32S3_CACHE_MMIO_PAGE 0x600c4000u
+#define ESP32S3_DCACHE_CONFIG 0x600c4000u
+#define ESP32S3_DCACHE_CTRL1 0x600c4004u
+#define ESP32S3_DCACHE_AUTOLOAD 0x600c404cu
+#define ESP32S3_ICACHE_CTRL1 0x600c4064u
+#define ESP32S3_ICACHE_AUTOLOAD 0x600c40a0u
+#define ESP32S3_CACHE_STATE 0x600c4130u
+#define ESP32S3_CACHE_IDLE 0x001001u
+#define ESP32S3_CACHE_AUTOLOAD_BASE 8u
+#define ESP32S3_CACHE_EVENT_VOID UINT32_MAX
+#define ELF_ROM_EVENT_RESET_REASON 1u
+#define ELF_ROM_EVENT_MEMSET 2u
+#define ELF_ROM_EVENT_CACHE 3u
+#define ELF_ROM_EVENT_CACHE_MODE 4u
+#define ELF_ROM_EVENT_CACHE_SUSPEND 5u
+#define NO_UNSUPPORTED_OFFSET UINT32_MAX
+#define INITIAL_STACK 0x3fcaffc0u
+#define INITIAL_SOURCE 0x3fca1000u
+#define INITIAL_DESTINATION 0x3fca2000u
+#define WINDOW_CALLINC 2u
+#define RESULT_ABI_VERSION 1u
+#define TRACE_ABI_VERSION 1u
+#define TRACE_CAPACITY 128u
+#define ELF_MEMORY_FAULT_ABI_VERSION 1u
+
+enum probe_stop_reason {
+    PROBE_STOP_RETURNED = 1,
+    PROBE_STOP_MAX_STEPS = 2,
+    PROBE_STOP_UNSUPPORTED = 3,
+    PROBE_STOP_STEP_ERROR = 4,
+    PROBE_STOP_INVALID_ARGUMENT = 5,
+    PROBE_STOP_ALLOCATION_FAILED = 6,
+    PROBE_STOP_CPU_STOPPED = 7,
+    PROBE_STOP_TRACE_OVERFLOW = 8,
+    PROBE_STOP_UNMAPPED_ACCESS = 9,
+    PROBE_STOP_UNLOADED_PAGE = 10,
+    PROBE_STOP_NON_EXECUTABLE_PAGE = 11,
+    PROBE_STOP_ROM_REFUSED = 12,
+    PROBE_STOP_READ_PERMISSION = 13,
+    PROBE_STOP_WRITE_PERMISSION = 14,
+};
+
+enum probe_trace_kind {
+    PROBE_TRACE_INSTRUCTION = 1,
+    PROBE_TRACE_READ = 2,
+    PROBE_TRACE_WRITE = 3,
+};
+
+struct probe_stop_record {
+    uint32_t abi_version;
+    uint32_t struct_bytes;
+    uint32_t reason;
+    uint32_t steps;
+    uint32_t start_pc;
+    uint32_t pc;
+    uint32_t return_pc;
+    uint32_t unsupported_pc;
+    uint32_t unsupported_encoding;
+    uint32_t unsupported_length;
+    uint32_t stack_pointer;
+    uint32_t registers[16];
+};
+
+struct unsupported_marker {
+    uint32_t pc;
+    uint32_t encoding;
+    uint32_t observed_pc;
+    uint32_t observed_encoding;
+    uint32_t observed_length;
+    int enabled;
+    int hit;
+};
+
+struct probe_trace_header {
+    uint32_t abi_version;
+    uint32_t header_bytes;
+    uint32_t record_bytes;
+    uint32_t count;
+    uint32_t capacity;
+    uint32_t overflow;
+};
+
+struct probe_trace_record {
+    uint32_t kind;
+    uint32_t pc;
+    uint32_t address;
+    uint32_t value;
+    uint32_t width;
+    uint32_t instruction;
+};
+
+struct probe_trace_buffer {
+    struct probe_trace_header header;
+    struct probe_trace_record records[TRACE_CAPACITY];
+};
+
+struct elf_probe_trace_buffer {
+    struct probe_trace_header header;
+    struct probe_trace_record records[ELF_MEMORY_TRACE_CAPACITY];
+};
+
+struct probe_write_undo {
+    uint8_t *pointer;
+    uint32_t previous;
+    uint32_t width;
+};
+
+struct probe_step_transaction {
+    uint32_t trace_start;
+    uint32_t undo_count;
+    int memory_overflow;
+    int access_refused;
+    struct probe_write_undo undo[TRACE_CAPACITY];
+};
+
+struct unsupported_entry {
+    uint32_t pc;
+    uint32_t encoding;
+};
+
+struct elf_memory_fault_record {
+    uint32_t abi_version;
+    uint32_t struct_bytes;
+    uint32_t pc;
+    uint32_t address;
+    uint32_t width;
+    uint32_t is_write;
+    uint32_t denied_address;
+    uint32_t denied_page;
+    uint32_t denied_flags;
+    int hit;
+};
+
+static xtensa_cpu_t cpu;
+static xtensa_mem_t *mem;
+static uint8_t input[INPUT_CAPACITY];
+static uint8_t data_input[DATA_CAPACITY];
+static uint8_t data_output[DATA_CAPACITY];
+static uint8_t code_page[PAGE_BYTES];
+static uint8_t source_page[PAGE_BYTES];
+static uint8_t destination_page[PAGE_BYTES];
+static uint8_t elf_page_input[PAGE_BYTES];
+static uint8_t elf_pages[ELF_PAGE_CAPACITY][PAGE_BYTES];
+static uint32_t elf_page_addresses[ELF_PAGE_CAPACITY];
+static uint32_t elf_page_flags[ELF_PAGE_CAPACITY];
+static uint32_t elf_page_count;
+static uint32_t elf_trace[ELF_TRACE_CAPACITY];
+static uint32_t elf_trace_count;
+static struct elf_probe_trace_buffer elf_memory_trace_buffer;
+static int elf_memory_trace_active;
+static struct unsupported_entry elf_unsupported[ELF_UNSUPPORTED_CAPACITY];
+static uint32_t elf_unsupported_count;
+static struct unsupported_marker elf_unsupported_hit;
+static uint32_t elf_rom_events[ELF_ROM_EVENT_CAPACITY][ELF_ROM_EVENT_WORDS];
+static uint32_t elf_rom_event_count;
+static uint32_t elf_rom_reset_reasons[2];
+static int elf_rom_reset_reason_enabled;
+static int elf_rom_memset_enabled;
+static int elf_rom_cache_enabled;
+static uint32_t elf_rom_cache_sequence;
+static uint32_t elf_rom_instruction_cache_mode[4];
+static int elf_rom_data_cache_suspended;
+static uint8_t elf_rom_cache_mmio[PAGE_BYTES];
+static uint32_t elf_rom_cache_state[11];
+static int elf_rom_refused;
+static struct elf_memory_fault_record elf_memory_fault;
+static struct probe_stop_record result;
+static struct probe_trace_buffer trace_buffer;
+static struct probe_step_transaction step_transaction;
+static xtensa_cpu_t cpu_checkpoint;
+
+static uint32_t probe_mmio_read(void *context, uint32_t unused_address) {
+    (void)unused_address;
+    uint8_t *side_effect = context;
+    side_effect[0]++;
+    return 0xa5a5a5a5u;
+}
+
+static void trace_reset(void) {
+    memset(&trace_buffer, 0, sizeof(trace_buffer));
+    trace_buffer.header.abi_version = TRACE_ABI_VERSION;
+    trace_buffer.header.header_bytes = (uint32_t)sizeof(trace_buffer.header);
+    trace_buffer.header.record_bytes = (uint32_t)sizeof(trace_buffer.records[0]);
+    trace_buffer.header.capacity = TRACE_CAPACITY;
+}
+
+static int trace_append(uint32_t kind, uint32_t pc, uint32_t address,
+                        uint32_t value, uint32_t width, uint32_t instruction) {
+    if (trace_buffer.header.count >= TRACE_CAPACITY) {
+        trace_buffer.header.overflow = 1;
+        return -1;
+    }
+    struct probe_trace_record *record =
+        &trace_buffer.records[trace_buffer.header.count++];
+    record->kind = kind;
+    record->pc = pc;
+    record->address = address;
+    record->value = value;
+    record->width = width;
+    record->instruction = instruction;
+    return 0;
+}
+
+static void elf_memory_trace_reset(void) {
+    memset(&elf_memory_trace_buffer, 0, sizeof(elf_memory_trace_buffer));
+    elf_memory_trace_buffer.header.abi_version = TRACE_ABI_VERSION;
+    elf_memory_trace_buffer.header.header_bytes =
+        (uint32_t)sizeof(elf_memory_trace_buffer.header);
+    elf_memory_trace_buffer.header.record_bytes =
+        (uint32_t)sizeof(elf_memory_trace_buffer.records[0]);
+    elf_memory_trace_buffer.header.capacity = ELF_MEMORY_TRACE_CAPACITY;
+}
+
+static int elf_memory_trace_append(uint32_t kind, uint32_t pc,
+                                   uint32_t address, uint32_t value,
+                                   uint32_t width, uint32_t instruction) {
+    if (elf_memory_trace_buffer.header.count >= ELF_MEMORY_TRACE_CAPACITY) {
+        elf_memory_trace_buffer.header.overflow = 1;
+        return -1;
+    }
+    struct probe_trace_record *record =
+        &elf_memory_trace_buffer.records[elf_memory_trace_buffer.header.count++];
+    record->kind = kind;
+    record->pc = pc;
+    record->address = address;
+    record->value = value;
+    record->width = width;
+    record->instruction = instruction;
+    return 0;
+}
+
+static void finish_record(uint32_t reason, uint32_t steps, uint32_t start_pc,
+                          uint32_t return_pc, const struct unsupported_marker *marker) {
+    result.abi_version = RESULT_ABI_VERSION;
+    result.struct_bytes = (uint32_t)sizeof(result);
+    result.reason = reason;
+    result.steps = steps;
+    result.start_pc = start_pc;
+    result.pc = cpu.pc;
+    result.return_pc = return_pc;
+    result.unsupported_pc = marker ? marker->observed_pc : 0;
+    result.unsupported_encoding = marker ? marker->observed_encoding : 0;
+    result.unsupported_length = marker ? marker->observed_length : 0;
+    result.stack_pointer = ar_read(&cpu, 1);
+    for (int i = 0; i < 16; i++) result.registers[i] = ar_read(&cpu, i);
+}
+
+static int trace_instruction(xtensa_cpu_t *unused_cpu, uint32_t pc, uint32_t insn,
+                             int length, void *context) {
+    (void)unused_cpu;
+    struct unsupported_marker *marker = context;
+    if (marker->enabled && pc == marker->pc && insn == marker->encoding) {
+        marker->hit = 1;
+        marker->observed_pc = pc;
+        marker->observed_encoding = insn;
+        marker->observed_length = (uint32_t)length;
+        return 1;
+    }
+    return trace_append(PROBE_TRACE_INSTRUCTION, pc, 0, 0,
+                        (uint32_t)length, insn) != 0;
+}
+
+static int trace_memory_access(void *context, uint32_t address,
+                               uint32_t value, uint32_t width, int is_write,
+                               int mapped) {
+    struct probe_step_transaction *transaction = context;
+    if (!mapped) {
+        transaction->access_refused = 1;
+        return 1;
+    }
+    if (trace_append(is_write ? PROBE_TRACE_WRITE : PROBE_TRACE_READ,
+                     g_dbg_pc, address, value, width, 0) != 0) {
+        transaction->memory_overflow = 1;
+        return 1;
+    }
+    if (is_write) {
+        uint32_t remaining = width;
+        uint32_t current = address;
+        while (remaining > 0) {
+            uint8_t *page = mem->page_table[current >> 12];
+            if (!page) break;
+            if (transaction->undo_count >= TRACE_CAPACITY) {
+                trace_buffer.header.overflow = 1;
+                transaction->memory_overflow = 1;
+                return 1;
+            }
+            uint32_t chunk = PAGE_BYTES - (current & (PAGE_BYTES - 1u));
+            if (chunk > remaining) chunk = remaining;
+            struct probe_write_undo *undo = &transaction->undo[transaction->undo_count++];
+            undo->pointer = page + (current & (PAGE_BYTES - 1u));
+            undo->width = chunk;
+            undo->previous = 0;
+            memcpy(&undo->previous, undo->pointer, chunk);
+            current += chunk;
+            remaining -= chunk;
+        }
+    }
+    return 0;
+}
+
+static void rollback_step(void) {
+    while (step_transaction.undo_count > 0) {
+        struct probe_write_undo *undo = &step_transaction.undo[--step_transaction.undo_count];
+        memcpy(undo->pointer, &undo->previous, undo->width);
+    }
+    cpu = cpu_checkpoint;
+    trace_buffer.header.count = step_transaction.trace_start;
+}
+
+static int stop_elf_unsupported(xtensa_cpu_t *unused_cpu, uint32_t pc, uint32_t insn,
+                                int length, void *unused_context) {
+    (void)unused_cpu;
+    (void)unused_context;
+    uint32_t low = 0;
+    uint32_t high = elf_unsupported_count;
+    while (low < high) {
+        uint32_t middle = low + (high - low) / 2u;
+        if (elf_unsupported[middle].pc < pc) low = middle + 1u;
+        else high = middle;
+    }
+    if (low < elf_unsupported_count && elf_unsupported[low].pc == pc) {
+        elf_unsupported_hit.hit = 1;
+        elf_unsupported_hit.observed_pc = pc;
+        elf_unsupported_hit.observed_encoding = insn;
+        elf_unsupported_hit.observed_length = (uint32_t)length;
+        elf_unsupported_hit.encoding = elf_unsupported[low].encoding;
+        return 1;
+    }
+    if (!elf_memory_trace_active) return 0;
+    return elf_memory_trace_append(PROBE_TRACE_INSTRUCTION, pc, 0, 0,
+                                   (uint32_t)length, insn) != 0;
+}
+
+static int trace_elf_memory_access(void *unused_context, uint32_t address,
+                                   uint32_t value, uint32_t width, int is_write,
+                                   int mapped) {
+    (void)unused_context;
+    if (!elf_memory_trace_active) return 0;
+    if (!mapped) return 0;
+    if (elf_memory_trace_append(
+            is_write ? PROBE_TRACE_WRITE : PROBE_TRACE_READ,
+            g_dbg_pc, address, value, width, 0) != 0) {
+        elf_memory_trace_buffer.header.overflow = 1;
+        return 1;
+    }
+    return 0;
+}
+
+static int elf_page_index(uint32_t address) {
+    uint32_t page = address & ~(PAGE_BYTES - 1u);
+    uint32_t low = 0;
+    uint32_t high = elf_page_count;
+    while (low < high) {
+        uint32_t middle = low + (high - low) / 2u;
+        if (elf_page_addresses[middle] < page) low = middle + 1u;
+        else high = middle;
+    }
+    return low < elf_page_count && elf_page_addresses[low] == page ? (int)low : -1;
+}
+
+static int elf_cache_mmio_permission(uint32_t address, uint32_t width, int is_write) {
+    if ((address & ~(PAGE_BYTES - 1u)) != ESP32S3_CACHE_MMIO_PAGE) return 0;
+    if (!elf_rom_cache_enabled || width != 4u) return -1;
+    switch (address) {
+    case ESP32S3_DCACHE_CTRL1:
+    case ESP32S3_DCACHE_AUTOLOAD:
+    case ESP32S3_ICACHE_CTRL1:
+    case ESP32S3_ICACHE_AUTOLOAD:
+        return 1;
+    case ESP32S3_CACHE_STATE:
+        return is_write ? -1 : 1;
+    default:
+        return -1;
+    }
+}
+
+static int elf_memory_permission(void *unused_context, uint32_t address,
+                                 uint32_t width, int is_write) {
+    (void)unused_context;
+    uint32_t required = is_write ? 2u : 4u;
+    uint32_t denied_address = address;
+    int denied_page = -1;
+    uint32_t denied_flags = 0;
+    if ((width != 1u && width != 2u && width != 4u) ||
+        address > UINT32_MAX - (width - 1u)) {
+        goto denied;
+    }
+    uint32_t remaining = width;
+    uint32_t current = address;
+    while (remaining > 0) {
+        int cache_mmio = elf_cache_mmio_permission(current, remaining, is_write);
+        if (cache_mmio > 0) return 0;
+        if (cache_mmio < 0) goto denied;
+        int page = elf_page_index(current);
+        uint32_t flags = page >= 0 ? elf_page_flags[page] : 0u;
+        if (page < 0 || mem->page_table[current >> 12] == NULL ||
+            (flags & required) == 0) {
+            denied_address = current;
+            denied_page = page;
+            denied_flags = flags;
+            goto denied;
+        }
+        uint32_t chunk = PAGE_BYTES - (current & (PAGE_BYTES - 1u));
+        if (chunk > remaining) chunk = remaining;
+        current += chunk;
+        remaining -= chunk;
+    }
+    return 0;
+
+denied:
+    memset(&elf_memory_fault, 0, sizeof(elf_memory_fault));
+    elf_memory_fault.abi_version = ELF_MEMORY_FAULT_ABI_VERSION;
+    elf_memory_fault.struct_bytes = (uint32_t)sizeof(elf_memory_fault);
+    elf_memory_fault.pc = g_dbg_pc;
+    elf_memory_fault.address = address;
+    elf_memory_fault.width = width;
+    elf_memory_fault.is_write = (uint32_t)is_write;
+    elf_memory_fault.denied_address = denied_address;
+    elf_memory_fault.denied_page = denied_address & ~(PAGE_BYTES - 1u);
+    elf_memory_fault.denied_flags = denied_flags;
+    elf_memory_fault.hit = 1;
+    return 1;
+}
+
+static uint32_t elf_rom_arg(xtensa_cpu_t *target_cpu, int argument) {
+    int callinc = XT_PS_CALLINC(target_cpu->ps);
+    int reg = callinc * 4 + 2 + argument;
+    if (reg < 16) return ar_read(target_cpu, reg);
+    return mem_read32(target_cpu->mem, ar_read(target_cpu, 1) + (uint32_t)(reg - 16) * 4u);
+}
+
+static void elf_rom_return(xtensa_cpu_t *target_cpu, uint32_t value) {
+    int callinc = XT_PS_CALLINC(target_cpu->ps);
+    if (callinc > 0) {
+        ar_write(target_cpu, callinc * 4 + 2, value);
+        target_cpu->pc = 0x40000000u | (ar_read(target_cpu, callinc * 4) & 0x3fffffffu);
+        XT_PS_SET_CALLINC(target_cpu->ps, 0);
+    } else {
+        ar_write(target_cpu, 2, value);
+        target_cpu->pc = 0x40000000u | (ar_read(target_cpu, 0) & 0x3fffffffu);
+    }
+}
+
+static int elf_rom_record(uint32_t kind, uint32_t pc, uint32_t arg0,
+                          uint32_t arg1, uint32_t arg2) {
+    if (elf_rom_event_count >= ELF_ROM_EVENT_CAPACITY) return 0;
+    uint32_t *event = elf_rom_events[elf_rom_event_count++];
+    event[0] = kind;
+    event[1] = pc;
+    event[2] = arg0;
+    event[3] = arg1;
+    event[4] = arg2;
+    return 1;
+}
+
+static uint32_t elf_cache_read(uint32_t address) {
+    uint32_t value = 0;
+    memcpy(&value, elf_rom_cache_mmio + (address - ESP32S3_CACHE_MMIO_PAGE), 4);
+    return value;
+}
+
+static void elf_cache_write(uint32_t address, uint32_t value) {
+    memcpy(elf_rom_cache_mmio + (address - ESP32S3_CACHE_MMIO_PAGE), &value, 4);
+}
+
+static void elf_cache_reset(void) {
+    memset(elf_rom_cache_mmio, 0, sizeof(elf_rom_cache_mmio));
+    elf_cache_write(ESP32S3_DCACHE_CONFIG, 1u);
+    elf_cache_write(ESP32S3_DCACHE_CTRL1, 0);
+    elf_cache_write(ESP32S3_DCACHE_AUTOLOAD, ESP32S3_CACHE_AUTOLOAD_BASE);
+    elf_cache_write(ESP32S3_ICACHE_CTRL1, 0);
+    elf_cache_write(ESP32S3_ICACHE_AUTOLOAD, ESP32S3_CACHE_AUTOLOAD_BASE);
+    elf_cache_write(ESP32S3_CACHE_STATE, ESP32S3_CACHE_IDLE);
+    elf_rom_cache_sequence = 0;
+    memset(elf_rom_instruction_cache_mode, 0, sizeof(elf_rom_instruction_cache_mode));
+    elf_rom_data_cache_suspended = 0;
+    mem->page_table[ESP32S3_CACHE_MMIO_PAGE >> 12] = elf_rom_cache_mmio;
+}
+
+static int elf_cache_is_callback(uint32_t pc) {
+    return pc == ESP32S3_ROM_CACHE_DISABLE_I || pc == ESP32S3_ROM_CACHE_ENABLE_I ||
+           pc == ESP32S3_ROM_CACHE_DISABLE_D || pc == ESP32S3_ROM_CACHE_ENABLE_D ||
+           pc == ESP32S3_ROM_SUSPEND_DCACHE || pc == ESP32S3_ROM_CONFIG_ICACHE_MODE;
+}
+
+static int elf_rom_instruction_cache_mode_dispatch(xtensa_cpu_t *target_cpu, uint32_t pc) {
+    if (pc != ESP32S3_ROM_CONFIG_ICACHE_MODE ||
+        elf_rom_event_count >= ELF_ROM_EVENT_CAPACITY ||
+        XT_PS_CALLINC(target_cpu->ps) != WINDOW_CALLINC ||
+        elf_rom_cache_sequence != 6u || elf_rom_instruction_cache_mode[0] != 0u ||
+        elf_cache_read(ESP32S3_ICACHE_CTRL1) != 0u ||
+        elf_cache_read(ESP32S3_DCACHE_CTRL1) != 0u ||
+        elf_cache_read(ESP32S3_ICACHE_AUTOLOAD) != ESP32S3_CACHE_AUTOLOAD_BASE ||
+        elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) != ESP32S3_CACHE_AUTOLOAD_BASE ||
+        elf_cache_read(ESP32S3_CACHE_STATE) != ESP32S3_CACHE_IDLE) {
+        return 0;
+    }
+    uint32_t size_bytes = elf_rom_arg(target_cpu, 0);
+    uint32_t ways = elf_rom_arg(target_cpu, 1);
+    uint32_t line_bytes = elf_rom_arg(target_cpu, 2);
+    if (size_bytes != 0x4000u || ways != 8u || line_bytes != 32u ||
+        !elf_rom_record(ELF_ROM_EVENT_CACHE_MODE, pc, size_bytes, ways, line_bytes)) {
+        return 0;
+    }
+    elf_rom_instruction_cache_mode[0] = 1u;
+    elf_rom_instruction_cache_mode[1] = size_bytes;
+    elf_rom_instruction_cache_mode[2] = ways;
+    elf_rom_instruction_cache_mode[3] = line_bytes;
+    elf_rom_return(target_cpu, 0);
+    return 1;
+}
+
+static int elf_rom_data_cache_suspend_dispatch(xtensa_cpu_t *target_cpu, uint32_t pc) {
+    if (pc != ESP32S3_ROM_SUSPEND_DCACHE ||
+        elf_rom_event_count >= ELF_ROM_EVENT_CAPACITY ||
+        XT_PS_CALLINC(target_cpu->ps) != WINDOW_CALLINC ||
+        elf_rom_cache_sequence != 6u || elf_rom_instruction_cache_mode[0] != 1u ||
+        elf_rom_data_cache_suspended ||
+        elf_cache_read(ESP32S3_DCACHE_CONFIG) != 1u ||
+        elf_cache_read(ESP32S3_DCACHE_CTRL1) != 0u ||
+        elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) != ESP32S3_CACHE_AUTOLOAD_BASE ||
+        elf_cache_read(ESP32S3_CACHE_STATE) != ESP32S3_CACHE_IDLE) {
+        return 0;
+    }
+    uint32_t return_value = elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & 4u;
+    elf_cache_write(ESP32S3_DCACHE_CTRL1,
+                    elf_cache_read(ESP32S3_DCACHE_CTRL1) | 3u);
+    elf_cache_write(ESP32S3_DCACHE_CONFIG,
+                    elf_cache_read(ESP32S3_DCACHE_CONFIG) & ~1u);
+    if (return_value != 0u) {
+        elf_cache_write(ESP32S3_DCACHE_AUTOLOAD,
+                        (elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & ~4u) | 0x200u);
+        elf_cache_write(ESP32S3_DCACHE_AUTOLOAD,
+                        elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & ~0x200u);
+    }
+    if (!elf_rom_record(ELF_ROM_EVENT_CACHE_SUSPEND, pc, 2u, return_value,
+                        ESP32S3_CACHE_EVENT_VOID)) {
+        return 0;
+    }
+    elf_rom_data_cache_suspended = 1;
+    elf_rom_return(target_cpu, return_value);
+    return 1;
+}
+
+static int elf_rom_cache_dispatch(xtensa_cpu_t *target_cpu, uint32_t pc) {
+    if (pc == ESP32S3_ROM_CONFIG_ICACHE_MODE) {
+        return elf_rom_instruction_cache_mode_dispatch(target_cpu, pc);
+    }
+    if (pc == ESP32S3_ROM_SUSPEND_DCACHE) {
+        return elf_rom_data_cache_suspend_dispatch(target_cpu, pc);
+    }
+    static const uint32_t expected_pc[6] = {
+        ESP32S3_ROM_CACHE_DISABLE_I, ESP32S3_ROM_CACHE_DISABLE_D,
+        ESP32S3_ROM_CACHE_ENABLE_I, ESP32S3_ROM_CACHE_ENABLE_D,
+        ESP32S3_ROM_CACHE_ENABLE_I, ESP32S3_ROM_CACHE_ENABLE_D,
+    };
+    static const uint32_t expected_i_ctrl1[6] = { 0, 1, 1, 0, 0, 0 };
+    static const uint32_t expected_d_ctrl1[6] = { 0, 0, 2, 2, 0, 0 };
+    if (elf_rom_event_count >= ELF_ROM_EVENT_CAPACITY ||
+        XT_PS_CALLINC(target_cpu->ps) != WINDOW_CALLINC ||
+        elf_rom_cache_sequence >= 6u || pc != expected_pc[elf_rom_cache_sequence] ||
+        elf_cache_read(ESP32S3_ICACHE_CTRL1) != expected_i_ctrl1[elf_rom_cache_sequence] ||
+        elf_cache_read(ESP32S3_DCACHE_CTRL1) != expected_d_ctrl1[elf_rom_cache_sequence] ||
+        elf_cache_read(ESP32S3_ICACHE_AUTOLOAD) != ESP32S3_CACHE_AUTOLOAD_BASE ||
+        elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) != ESP32S3_CACHE_AUTOLOAD_BASE ||
+        elf_cache_read(ESP32S3_CACHE_STATE) != ESP32S3_CACHE_IDLE) {
+        return 0;
+    }
+
+    uint32_t argument = ESP32S3_CACHE_EVENT_VOID;
+    uint32_t return_value = ESP32S3_CACHE_EVENT_VOID;
+    if (pc == ESP32S3_ROM_CACHE_DISABLE_I) {
+        return_value = elf_cache_read(ESP32S3_ICACHE_AUTOLOAD) & 4u;
+        elf_cache_write(ESP32S3_ICACHE_AUTOLOAD,
+                        elf_cache_read(ESP32S3_ICACHE_AUTOLOAD) & ~4u);
+        elf_cache_write(ESP32S3_ICACHE_CTRL1,
+                        elf_cache_read(ESP32S3_ICACHE_CTRL1) | 1u);
+    } else if (pc == ESP32S3_ROM_CACHE_DISABLE_D) {
+        return_value = elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & 4u;
+        elf_cache_write(ESP32S3_DCACHE_AUTOLOAD,
+                        elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & ~4u);
+        elf_cache_write(ESP32S3_DCACHE_CTRL1,
+                        elf_cache_read(ESP32S3_DCACHE_CTRL1) | 2u);
+    } else {
+        argument = elf_rom_arg(target_cpu, 0);
+        if (argument != 0) return 0;
+        if (pc == ESP32S3_ROM_CACHE_ENABLE_I) {
+            elf_cache_write(ESP32S3_ICACHE_AUTOLOAD,
+                            (elf_cache_read(ESP32S3_ICACHE_AUTOLOAD) & ~4u) | argument);
+            elf_cache_write(ESP32S3_ICACHE_CTRL1,
+                            elf_cache_read(ESP32S3_ICACHE_CTRL1) & ~1u);
+        } else {
+            elf_cache_write(ESP32S3_DCACHE_AUTOLOAD,
+                            (elf_cache_read(ESP32S3_DCACHE_AUTOLOAD) & ~4u) | argument);
+            elf_cache_write(ESP32S3_DCACHE_CTRL1,
+                            elf_cache_read(ESP32S3_DCACHE_CTRL1) & ~2u);
+        }
+    }
+    if (!elf_rom_record(ELF_ROM_EVENT_CACHE, pc, elf_rom_cache_sequence,
+                        argument, return_value)) return 0;
+    elf_rom_cache_sequence++;
+    elf_rom_return(target_cpu, return_value == ESP32S3_CACHE_EVENT_VOID ? 0 : return_value);
+    return 1;
+}
+
+static int elf_rom_pc_hook(xtensa_cpu_t *target_cpu, uint32_t pc, void *unused_context) {
+    (void)unused_context;
+    if (elf_rom_cache_enabled && elf_cache_is_callback(pc)) {
+        if (!elf_rom_cache_dispatch(target_cpu, pc)) elf_rom_refused = 1;
+        return 1;
+    }
+    if (pc == ESP32S3_ROM_RESET_REASON && elf_rom_reset_reason_enabled) {
+        uint32_t core = elf_rom_arg(target_cpu, 0);
+        if (core > 1u || !elf_rom_record(ELF_ROM_EVENT_RESET_REASON, pc, core,
+                                        elf_rom_reset_reasons[core <= 1u ? core : 0u], 0)) {
+            elf_rom_refused = 1;
+            return 1;
+        }
+        elf_rom_return(target_cpu, elf_rom_reset_reasons[core]);
+        return 1;
+    }
+    if (pc == ESP32S3_ROM_MEMSET && elf_rom_memset_enabled) {
+        uint32_t destination = elf_rom_arg(target_cpu, 0);
+        uint32_t value = elf_rom_arg(target_cpu, 1) & 0xffu;
+        uint32_t length = elf_rom_arg(target_cpu, 2);
+        if (length > ELF_ROM_MEMSET_MAX_BYTES || destination + length < destination) {
+            elf_rom_refused = 1;
+            return 1;
+        }
+        for (uint32_t offset = 0; offset < length;) {
+            uint32_t address = destination + offset;
+            int page = elf_page_index(address);
+            if (page < 0 || (elf_page_flags[page] & 2u) == 0) {
+                elf_rom_refused = 1;
+                return 1;
+            }
+            uint32_t chunk = PAGE_BYTES - (address & (PAGE_BYTES - 1u));
+            if (chunk > length - offset) chunk = length - offset;
+            offset += chunk;
+        }
+        if (!elf_rom_record(ELF_ROM_EVENT_MEMSET, pc, destination, value, length)) {
+            elf_rom_refused = 1;
+            return 1;
+        }
+        for (uint32_t offset = 0; offset < length;) {
+            uint32_t address = destination + offset;
+            uint32_t chunk = PAGE_BYTES - (address & (PAGE_BYTES - 1u));
+            if (chunk > length - offset) chunk = length - offset;
+            memset(mem->page_table[address >> 12] + (address & (PAGE_BYTES - 1u)),
+                   (int)value, chunk);
+            offset += chunk;
+        }
+        elf_rom_return(target_cpu, destination);
+        return 1;
+    }
+    return 0;
+}
