node_modules/

# Build outputs: regenerate with `bun run example:build` / `bun run build`
wasm/dist/
dist/

# The device firmware's CMake build tree (25MB of objects and a copy of half
# the Pico SDK's object files). Regenerate with the two cmake commands in
# device/README.md; the .uf2 it produces is attached to a GitHub release,
# never committed.
device/firmware/build/

# Hostile-firmware regression suite build output: regenerate with
# `bun run test:hostile` (or `bun run test/hostile/build.ts` on its own)
test/hostile/dist/

# Regression-check test fixture build output: regenerate with
# `bun run test:regression` (or `bun run test/regression/build.ts` on its own)
test/regression/dist/
test/storage/dist/

# C++20/WASI loader fixture build output: regenerate with `bun run test:wasi`
test/wasi/build/
test/wasi/dist/

# Runtime-written, transient (see docs/agent-loop.md)
freezes/
traces/

# The hardware-free regression check's own state (src/regression.ts):
# baselines/ is what you saved, regressions/ is the last check's result.
# Both transient by the same reasoning as freezes/ and traces/ above.
baselines/
regressions/
/storage/

# Differential harness output (PNGs from `bun run harness/diff.ts --out`)
harness/out/

*.log
.DS_Store
Thumbs.db
