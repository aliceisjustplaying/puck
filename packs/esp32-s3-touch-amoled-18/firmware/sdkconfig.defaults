# Board and toolchain configuration for the Waveshare ESP32-S3-Touch-AMOLED-1.8.
#
# Every line here was either measured on this board or copied from a
# configuration already proven on it (tinydraw's esp32/sdkconfig.defaults,
# same silicon, same enclosure). Nothing is a guess carried over from a
# generic ESP32-S3 template.

# The ESP32-S3R8 in this module carries in-package octal PSRAM. This pack
# keeps NO framebuffer in it (see AGENTS.md's memory model): the only thing
# that ever lands there is devlink's greyscale capture buffer, which exists
# for the differential harness and is not on the drawing path at all - see
# docs/decisions/0002-devlink-over-usb-serial-jtag.md.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# THE CONSOLE IS THE NATIVE USB SERIAL/JTAG PORT, NOT UART0. This is what
# makes the board enumerate as one plain serial port that carries both the
# log and devlink's own traffic, which is the whole transport argument in
# docs/decisions/0002-devlink-over-usb-serial-jtag.md. Left at its UART0
# default, the board would print to pins nothing on this enclosure breaks
# out, and devlink would have no wire at all.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
