diff --git a/src/xtensa.h b/src/xtensa.h
index 7f70ab1..09e3182 100644
--- a/src/xtensa.h
+++ b/src/xtensa.h
@@ -12,6 +12,10 @@ typedef struct xtensa_cpu xtensa_cpu_t;
 /* PC hook: return non-zero to skip normal fetch/execute for this cycle */
 typedef int (*xtensa_pc_hook_fn)(xtensa_cpu_t *cpu, uint32_t pc, void *ctx);

+/* Instruction hook: return non-zero to stop before executing the instruction. */
+typedef int (*xtensa_instruction_hook_fn)(xtensa_cpu_t *cpu, uint32_t pc,
+                                          uint32_t insn, int length, void *ctx);
+
 /* Pre-decoded instruction table: entire firmware decoded at load time.
  * Direct-indexed by (pc - PREDECODE_BASE), no tags, no cache misses.
  * Packed: bits 0-23 = instruction word, bits 24-25 = ilen (2 or 3).
@@ -248,6 +252,10 @@ struct xtensa_cpu {
     xtensa_pc_hook_fn pc_hook;          /* PC hook (for ROM stubs etc.) */
     void             *pc_hook_ctx;
     const uint64_t   *pc_hook_bitmap;   /* Fast-path bitmap: skip hook if bit not set */
+    xtensa_instruction_hook_fn instruction_hook;
+    void                       *instruction_hook_ctx;
+    uint32_t                    external_exec_begin;
+    uint32_t                    external_exec_end;
     uint32_t         *predecode;        /* Pre-decoded instruction table (heap, 20MB) */
     /* AOT static-recompiled function table.
      * `aot` is opaque to xtensa.c; xtensa_step_impl just calls
