+            break;
+        case 0x8d6004u:
+            esp32s3_copy_from_memory(cpu, cpu->qr[q] + 8, address, 8);
+            break;
+        case 0xcd4004u:
+            esp32s3_copy_to_memory(cpu, address, cpu->qr[q], 8);
+            break;
+        default:
