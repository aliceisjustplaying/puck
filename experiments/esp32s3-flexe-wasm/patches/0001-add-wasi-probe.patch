@@ -2296,6 +2300,10 @@ int xtensa_step_impl(xtensa_cpu_t *cpu, uint64_t *restrict local_cc) {
 have_insn:
 #endif

+    if (cpu->instruction_hook &&
+        cpu->instruction_hook(cpu, cpu->pc, insn, ilen, cpu->instruction_hook_ctx))
+        return -2;
+
     cpu->_pc_written = false;
