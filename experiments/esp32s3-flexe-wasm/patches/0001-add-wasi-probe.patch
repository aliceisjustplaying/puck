+    elf_rom_cache_state[3] = elf_cache_read(ESP32S3_ICACHE_CTRL1);
+    elf_rom_cache_state[4] = elf_cache_read(ESP32S3_ICACHE_AUTOLOAD);
+    elf_rom_cache_state[5] = elf_cache_read(ESP32S3_CACHE_STATE);
+    elf_rom_cache_state[6] = elf_rom_instruction_cache_mode[0];
+    elf_rom_cache_state[7] = elf_rom_instruction_cache_mode[1];
+    elf_rom_cache_state[8] = elf_rom_instruction_cache_mode[2];
