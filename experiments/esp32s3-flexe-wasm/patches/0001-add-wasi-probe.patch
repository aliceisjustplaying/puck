+FLEXE_EXPORT("flexe_wasm_elf_begin")
+uint32_t flexe_wasm_elf_begin(void) {
+    if (!mem) mem = mem_create();
+    if (!mem) return 0;
+    mem_reset(mem);
+    memset(mem->page_table, 0, sizeof(mem->page_table));
+    elf_page_count = 0;
+    elf_trace_count = 0;
+    elf_memory_trace_reset();
+    elf_memory_trace_active = 0;
+    elf_unsupported_count = 0;
+    elf_rom_event_count = 0;
+    elf_rom_reset_reason_enabled = 0;
+    elf_rom_memset_enabled = 0;
+    elf_rom_cache_enabled = 0;
+    elf_rom_cache_sequence = 0;
+    memset(elf_rom_instruction_cache_mode, 0, sizeof(elf_rom_instruction_cache_mode));
+    elf_rom_data_cache_suspended = 0;
+    elf_rom_refused = 0;
+    memset(&elf_memory_fault, 0, sizeof(elf_memory_fault));
+    mem->permission_hook = NULL;
+    mem->permission_hook_ctx = NULL;
+    memset(&elf_unsupported_hit, 0, sizeof(elf_unsupported_hit));
+    return 1;
+}
+
+FLEXE_EXPORT("flexe_wasm_elf_load_page")
+uint32_t flexe_wasm_elf_load_page(uint32_t address, uint32_t flags) {
+    if (!mem) return 0;
+    if ((address & (PAGE_BYTES - 1u)) != 0 || (flags & ~7u) != 0) return 2;
+    if (elf_page_count >= ELF_PAGE_CAPACITY) return 3;
+    if (elf_page_count > 0 && address <= elf_page_addresses[elf_page_count - 1u]) return 4;
+    memcpy(elf_pages[elf_page_count], elf_page_input, PAGE_BYTES);
+    elf_page_addresses[elf_page_count] = address;
+    elf_page_flags[elf_page_count] = flags;
+    mem->page_table[address >> 12] = elf_pages[elf_page_count];
+    elf_page_count++;
+    return 1;
+}
+
+static int elf_bound_instruction_encoding(uint32_t pc, uint32_t *encoding) {
+    int page = elf_page_index(pc);
+    if (page < 0 || mem->page_table[pc >> 12] == NULL ||
+        (elf_page_flags[page] & 1u) == 0) return 0;
+    uint8_t first = mem->page_table[pc >> 12][pc & (PAGE_BYTES - 1u)];
+    uint32_t length = (first & 8u) != 0 ? 2u : 3u;
+    if (pc > UINT32_MAX - (length - 1u)) return 0;
+    uint32_t value = 0;
+    for (uint32_t offset = 0; offset < length; offset++) {
+        uint32_t address = pc + offset;
+        int current_page = elf_page_index(address);
+        if (current_page < 0 || mem->page_table[address >> 12] == NULL ||
+            (elf_page_flags[current_page] & 1u) == 0) return 0;
+        value |= (uint32_t)mem->page_table[address >> 12]
+                     [address & (PAGE_BYTES - 1u)] << (offset * 8u);
+    }
+    *encoding = value;
+    return 1;
+}
+
+FLEXE_EXPORT("flexe_wasm_elf_set_unsupported")
+uint32_t flexe_wasm_elf_set_unsupported(uint32_t count) {
+    if (!mem) return 0;
+    if (count > ELF_UNSUPPORTED_CAPACITY) return 2;
+    for (uint32_t i = 0; i < count; i++) {
+        if (elf_unsupported[i].encoding > 0xffffffu) return 3;
+        if (i > 0 && elf_unsupported[i - 1u].pc >= elf_unsupported[i].pc) return 4;
+        uint32_t loaded_encoding = 0;
+        if (!elf_bound_instruction_encoding(elf_unsupported[i].pc, &loaded_encoding) ||
+            elf_unsupported[i].encoding != loaded_encoding) return 5;
+    }
+    elf_unsupported_count = count;
+    return 1;
+}
+
+static uint32_t run_internal(uint32_t pc, uint32_t code_length, uint32_t max_steps,
+                             uint32_t unsupported_offset, uint32_t unsupported_encoding,
+                             uint32_t data_length) {
+    memset(&result, 0, sizeof(result));
+    memset(&cpu, 0, sizeof(cpu));
+    memset(data_output, 0, sizeof(data_output));
+    trace_reset();
+    result.abi_version = RESULT_ABI_VERSION;
+    result.struct_bytes = (uint32_t)sizeof(result);
+    result.start_pc = pc;
+    result.pc = pc;
+    if (code_length == 0 || code_length > INPUT_CAPACITY || max_steps == 0 ||
+        data_length > DATA_CAPACITY || (data_length & 1u) != 0 ||
+        (pc & (PAGE_BYTES - 1u)) + code_length > PAGE_BYTES ||
+        (unsupported_offset != NO_UNSUPPORTED_OFFSET && unsupported_offset >= code_length)) {
+        result.reason = PROBE_STOP_INVALID_ARGUMENT;
+        return (uint32_t)(uintptr_t)&result;
+    }
+
+    if (!mem) mem = mem_create();
+    if (!mem) {
+        result.reason = PROBE_STOP_ALLOCATION_FAILED;
+        return (uint32_t)(uintptr_t)&result;
+    }
+    mem->access_hook = NULL;
+    mem->access_hook_ctx = NULL;
+    mem->permission_hook = NULL;
+    mem->permission_hook_ctx = NULL;
+    mem_reset(mem);
+    if (mem_register_mmio_range(mem, 0x3ff40000u, PAGE_BYTES,
+                                probe_mmio_read, NULL, destination_page) != 0) {
+        result.reason = PROBE_STOP_ALLOCATION_FAILED;
+        return (uint32_t)(uintptr_t)&result;
+    }
+    memset(code_page, 0, sizeof(code_page));
+    memcpy(code_page + (pc & (PAGE_BYTES - 1u)), input, code_length);
+    mem->page_table[pc >> 12] = code_page;
+    if (data_length > 0) {
+        memset(source_page, 0, sizeof(source_page));
+        memset(destination_page, 0, sizeof(destination_page));
+        memcpy(source_page, data_input, data_length);
+        mem->page_table[INITIAL_SOURCE >> 12] = source_page;
+        mem->page_table[INITIAL_DESTINATION >> 12] = destination_page;
+    }
+
+    xtensa_cpu_init(&cpu);
+    cpu.mem = mem;
+    cpu.pc = pc;
+    cpu.running = true;
+    cpu.ps = (1u << 18) | (WINDOW_CALLINC << 16);
+    cpu.windowbase = 0;
+    cpu.windowstart = 1;
+    cpu.window_callsize[0] = WINDOW_CALLINC;
+    cpu.external_exec_begin = pc & ~(PAGE_BYTES - 1u);
+    cpu.external_exec_end = cpu.external_exec_begin + PAGE_BYTES;
+
+    uint32_t return_pc = (pc & ~(PAGE_BYTES - 1u)) + PAGE_BYTES;
+    ar_write(&cpu, 1, INITIAL_STACK);
+    ar_write(&cpu, 8, (WINDOW_CALLINC << 30) | (return_pc & 0x3fffffffu));
+    ar_write(&cpu, 10, INITIAL_SOURCE);
+    ar_write(&cpu, 11, INITIAL_DESTINATION);
+    ar_write(&cpu, 12, data_length > 0 ? data_length / 2u : 1u);
+
+    struct unsupported_marker marker = {
+        .pc = pc + unsupported_offset,
+        .encoding = unsupported_encoding,
+        .enabled = unsupported_offset != NO_UNSUPPORTED_OFFSET,
+    };
+    cpu.instruction_hook = trace_instruction;
+    cpu.instruction_hook_ctx = &marker;
+    mem->access_hook = trace_memory_access;
+    mem->access_hook_ctx = &step_transaction;
+
+    uint32_t steps = 0;
+    uint32_t reason = PROBE_STOP_MAX_STEPS;
+    while (1) {
+        if (cpu.pc == return_pc) {
+            reason = PROBE_STOP_RETURNED;
+            break;
+        }
+        if (steps >= max_steps) break;
+        memset(&step_transaction, 0, sizeof(step_transaction));
+        step_transaction.trace_start = trace_buffer.header.count;
+        cpu_checkpoint = cpu;
+        int step_result = xtensa_step(&cpu);
+        if (marker.hit) {
+            rollback_step();
+            reason = PROBE_STOP_UNSUPPORTED;
+            break;
+        }
+        if (step_transaction.access_refused) {
+            rollback_step();
+            reason = PROBE_STOP_UNMAPPED_ACCESS;
+            break;
+        }
+        if (step_transaction.memory_overflow) {
+            rollback_step();
+            reason = PROBE_STOP_TRACE_OVERFLOW;
+            break;
+        }
+        if (trace_buffer.header.overflow) {
+            rollback_step();
+            reason = PROBE_STOP_TRACE_OVERFLOW;
+            break;
+        }
+        if (step_result != 0) {
+            rollback_step();
+            reason = PROBE_STOP_STEP_ERROR;
+            break;
+        }
+        steps++;
+        if (!cpu.running) {
+            reason = PROBE_STOP_CPU_STOPPED;
+            break;
+        }
+    }
+
+    mem->access_hook = NULL;
+    mem->access_hook_ctx = NULL;
+    if (data_length > 0) memcpy(data_output, destination_page, data_length);
+    finish_record(reason, steps, pc, return_pc, marker.hit ? &marker : NULL);
+    return (uint32_t)(uintptr_t)&result;
+}
+
+FLEXE_EXPORT("flexe_wasm_run")
+uint32_t flexe_wasm_run(uint32_t pc, uint32_t code_length, uint32_t max_steps,
+                        uint32_t unsupported_offset, uint32_t unsupported_encoding) {
+    return run_internal(pc, code_length, max_steps, unsupported_offset,
+                        unsupported_encoding, 0);
+}
+
+FLEXE_EXPORT("flexe_wasm_run_data")
+uint32_t flexe_wasm_run_data(uint32_t pc, uint32_t code_length, uint32_t max_steps,
+                             uint32_t unsupported_offset, uint32_t unsupported_encoding,
+                             uint32_t data_length) {
+    return run_internal(pc, code_length, max_steps, unsupported_offset,
+                        unsupported_encoding, data_length);
+}
+
+FLEXE_EXPORT("flexe_wasm_run_elf")
+uint32_t flexe_wasm_run_elf(uint32_t entry, uint32_t max_steps,
+                            uint32_t initial_stack) {
+    memset(&result, 0, sizeof(result));
+    memset(&cpu, 0, sizeof(cpu));
+    memset(&elf_unsupported_hit, 0, sizeof(elf_unsupported_hit));
+    elf_trace_count = 0;
+    elf_rom_event_count = 0;
+    elf_rom_refused = 0;
+    memset(&elf_memory_fault, 0, sizeof(elf_memory_fault));
+    if (elf_rom_cache_enabled) elf_cache_reset();
+    result.abi_version = RESULT_ABI_VERSION;
+    result.struct_bytes = (uint32_t)sizeof(result);
+    result.start_pc = entry;
+    result.pc = entry;
+    if (!mem || elf_page_count == 0 || max_steps == 0 || max_steps > ELF_TRACE_CAPACITY) {
+        result.reason = PROBE_STOP_INVALID_ARGUMENT;
+        return (uint32_t)(uintptr_t)&result;
+    }
+
+    int entry_page = elf_page_index(entry);
+    if (entry_page < 0) {
+        result.reason = PROBE_STOP_UNLOADED_PAGE;
+        return (uint32_t)(uintptr_t)&result;
+    }
+    if ((elf_page_flags[entry_page] & 1u) == 0) {
+        result.reason = PROBE_STOP_NON_EXECUTABLE_PAGE;
+        return (uint32_t)(uintptr_t)&result;
+    }
+
+    xtensa_cpu_init(&cpu);
+    cpu.mem = mem;
+    cpu.pc = entry;
+    cpu.running = true;
+    cpu.ps = (1u << 18) | (WINDOW_CALLINC << 16);
+    cpu.windowbase = 0;
+    cpu.windowstart = 1;
+    cpu.window_callsize[0] = WINDOW_CALLINC;
+    ar_write(&cpu, 1, initial_stack);
+    mem->permission_hook = elf_memory_permission;
+    mem->permission_hook_ctx = NULL;
+    if (elf_rom_reset_reason_enabled || elf_rom_memset_enabled || elf_rom_cache_enabled) {
+        cpu.pc_hook = elf_rom_pc_hook;
+        cpu.pc_hook_ctx = NULL;
+    }
+    cpu.instruction_hook = stop_elf_unsupported;
+    cpu.instruction_hook_ctx = NULL;
+
+    uint32_t steps = 0;
+    uint32_t reason = PROBE_STOP_MAX_STEPS;
+    while (steps < max_steps) {
+        int configured_rom =
+            (cpu.pc == ESP32S3_ROM_RESET_REASON && elf_rom_reset_reason_enabled) ||
+            (cpu.pc == ESP32S3_ROM_MEMSET && elf_rom_memset_enabled) ||
+            (elf_rom_cache_enabled && elf_cache_is_callback(cpu.pc));
+        if (!configured_rom) {
+            int page = elf_page_index(cpu.pc);
+            if (page < 0 || mem->page_table[cpu.pc >> 12] == NULL) {
+                reason = PROBE_STOP_UNLOADED_PAGE;
+                break;
+            }
+            if ((elf_page_flags[page] & 1u) == 0) {
+                reason = PROBE_STOP_NON_EXECUTABLE_PAGE;
+                break;
+            }
+            uint8_t first = mem->page_table[cpu.pc >> 12][cpu.pc & (PAGE_BYTES - 1u)];
+            uint32_t instruction_length = (first & 8u) != 0 ? 2u : 3u;
+            if (cpu.pc > UINT32_MAX - (instruction_length - 1u)) {
+                reason = PROBE_STOP_UNLOADED_PAGE;
+                break;
+            }
+            if ((cpu.pc & (PAGE_BYTES - 1u)) + instruction_length > PAGE_BYTES) {
+                int trailing_page = elf_page_index(cpu.pc + instruction_length - 1u);
+                if (trailing_page < 0) {
+                    reason = PROBE_STOP_UNLOADED_PAGE;
+                    break;
+                }
+                if ((elf_page_flags[trailing_page] & 1u) == 0) {
+                    reason = PROBE_STOP_NON_EXECUTABLE_PAGE;
+                    break;
+                }
+            }
+        }
+
+        uint32_t executed_pc = cpu.pc;
+        uint32_t trace_checkpoint = elf_trace_count;
+        uint32_t memory_trace_checkpoint = elf_memory_trace_buffer.header.count;
+        uint32_t rom_event_checkpoint = elf_rom_event_count;
+        cpu_checkpoint = cpu;
+        elf_memory_trace_active = !configured_rom;
+        mem->access_hook = trace_elf_memory_access;
+        mem->access_hook_ctx = NULL;
+        int step_result = xtensa_step(&cpu);
+        elf_memory_trace_active = 0;
+        mem->access_hook = NULL;
+        mem->access_hook_ctx = NULL;
+        if (elf_memory_fault.hit) {
+            cpu = cpu_checkpoint;
+            elf_memory_trace_buffer.header.count = memory_trace_checkpoint;
+            reason = elf_memory_fault.is_write ? PROBE_STOP_WRITE_PERMISSION :
+                                                 PROBE_STOP_READ_PERMISSION;
+            break;
+        }
+        if (elf_rom_refused) {
+            elf_memory_trace_buffer.header.count = memory_trace_checkpoint;
+            reason = PROBE_STOP_ROM_REFUSED;
+            break;
+        }
+        if (elf_unsupported_hit.hit) {
+            elf_memory_trace_buffer.header.count = memory_trace_checkpoint;
+            reason = PROBE_STOP_UNSUPPORTED;
+            break;
+        }
+        if (elf_memory_trace_buffer.header.overflow) {
+            cpu = cpu_checkpoint;
+            elf_memory_trace_buffer.header.count = memory_trace_checkpoint;
+            reason = PROBE_STOP_TRACE_OVERFLOW;
+            break;
+        }
+        if (step_result != 0) {
+            cpu = cpu_checkpoint;
+            elf_trace_count = trace_checkpoint;
+            elf_memory_trace_buffer.header.count = memory_trace_checkpoint;
+            elf_rom_event_count = rom_event_checkpoint;
+            reason = PROBE_STOP_STEP_ERROR;
+            break;
+        }
+        if (configured_rom) continue;
+        elf_trace[elf_trace_count++] = executed_pc;
+        steps++;
+        if (!cpu.running) {
+            reason = PROBE_STOP_CPU_STOPPED;
+            break;
+        }
+    }
+
+    mem->permission_hook = NULL;
+    mem->permission_hook_ctx = NULL;
+    mem->access_hook = NULL;
+    mem->access_hook_ctx = NULL;
+
+    finish_record(reason, steps, entry, 0,
+                  elf_unsupported_hit.hit ? &elf_unsupported_hit : NULL);
+    return (uint32_t)(uintptr_t)&result;
+}
+
+FLEXE_EXPORT("flexe_wasm_probe")
+uint32_t flexe_wasm_probe(void) {
+    static const uint8_t fixture[] = {
+        0x32, 0xa0, 0x28,
+        0x32, 0xc3, 0x02,
+    };
+    memcpy(input, fixture, sizeof(fixture));
+    (void)flexe_wasm_run(FIXTURE_PC, (uint32_t)sizeof(fixture), 2,
+                         NO_UNSUPPORTED_OFFSET, 0);
+    if (result.reason != PROBE_STOP_MAX_STEPS || result.pc != FIXTURE_PC + sizeof(fixture))
+        return 0xdead0001u;
+    return result.registers[3];
+}
+
+#ifdef FLEXE_PROBE_NATIVE
+int main(void) {
+    uint32_t probe_result = flexe_wasm_probe();
+    printf("%u\n", probe_result);
+    return probe_result == 42u ? 0 : 1;
+}
+#endif
