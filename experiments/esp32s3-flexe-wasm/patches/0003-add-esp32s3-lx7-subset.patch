+    if (half_xp_opcode == 0x8d3004u || half_xp_opcode == 0x8d6004u ||
+        half_xp_opcode == 0xcd4004u || half_xp_opcode == 0xcd0004u) {
+        unsigned q = esp32s3_qr(insn);
+        unsigned base_register = XT_T(insn);
+        unsigned increment_register = (insn >> 8) & 15u;
+        uint32_t base = ar_read(cpu, base_register);
+        uint32_t increment = ar_read(cpu, increment_register);
+        uint32_t address = base & ~7u;
+        switch (half_xp_opcode) {
+        case 0x8d3004u:
