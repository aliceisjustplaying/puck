{
  "name": "puck",
  "private": true,
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run scripts/verify.ts",
    "verify:embed": "bun run scripts/verify-embed.ts",
    "verify:tilt": "bun run scripts/verify-tilt.ts",
    "verify:motion": "bun run scripts/verify-motion.ts",
    "example:build": "bun run example/build.ts",
    "pack:build": "bun run packs/rp2350-touch-amoled-18/wasm/build.ts",
    "pack:esp32:build": "bun run packs/esp32-s3-touch-amoled-18/wasm/build.ts",
    "pack:screens": "bun run packs/rp2350-touch-amoled-18/tools/screens.ts",
    "pack:demo": "bun run packs/rp2350-touch-amoled-18/tools/demo.ts",
    "harness:selftest": "bun run harness/selftest.ts",
    "portdiff": "bun run harness/portdiff.ts",
    "invariants": "bun run harness/invariantRun.ts",
    "harness:hardware": "bun run harness/diff.ts harness/inputs/chrono-idle.trace.json --link harness/links/devlinkLink.ts",
    "harness:hardware:pacing": "bun run harness/hardwarePacing.ts",
    "test:hostile": "bun run test/hostile/run.ts",
    "test:regression": "bun run test/regression/run.ts",
    "site:build": "bun run site/build.ts",
    "site:record-demos": "bun run site/record-demos.ts",
    "site:verify-flash-ui": "bun run scripts/verify-flash-ui.ts",
    "site:verify-embeds": "bun run scripts/verify-site-embeds.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.14",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.7.0"
  }
}
